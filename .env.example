# Supabase Postgres pooled connection string:
# Supabase dashboard -> Project Settings -> Database -> Connection string (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase project URL + keys (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-server-only>

# Cloudflare Workers AI (optional - enables the AI room-restyle beta)
# Create a Cloudflare API token with Workers AI access and copy your account ID.
# Check your Cloudflare plan/pricing before enabling usage in production.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Required for the shared daily AI usage cap (run supabase/ai-makeover-budget.sql once).
# The existing DATABASE_URL above is reused; do not expose it in NEXT_PUBLIC_* vars.
